<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Hardware features ──────────────────────────────────────────────── -->
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <!-- ── Permissions ───────────────────────────────────────────────────── -->
    <!-- Camera access inside the foreground service -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Keep the service alive with a visible persistent notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- API 29+: must declare the exact foreground service type used -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Draw the full-screen break overlay on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required on Android 13+ (API 33) to post the persistent notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Haptic feedback / vibration on break trigger -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Query screen time / app usage data -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Query all packages to load app names and icons on Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AttentionTracker">

        <!-- ── Main launcher activity ─────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Attention Foreground Service ──────────────────────────────── -->
        <!--
            foregroundServiceType="camera" is mandatory on API 29+ when a
            foreground service accesses the camera. Without it the system
            throws a MissingForegroundServiceTypeException at runtime.
        -->
        <service
            android:name=".service.AttentionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera" />

    </application>
</manifest>
